# Copy this file to ".env" and fill in your credentials, then load it into your
# shell before running an example:  export $(grep -v '^#' .env | xargs)
#
# From your FastPix Dashboard (https://dashboard.fastpix.com):
#   Access Token -> FASTPIX_USERNAME
#   Secret Key   -> FASTPIX_PASSWORD
FASTPIX_USERNAME=
FASTPIX_PASSWORD=

# From Dashboard > Webhooks (only needed to verify webhook signatures).
FASTPIX_WEBHOOK_SECRET=

# Optional: override the default API base URL.
# FASTPIX_SERVER_URL=https://api.fastpix.com/v1/
